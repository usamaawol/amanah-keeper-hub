# ──────────────────────────────────────────────────────────────────────────────
# Amanah Keeper Hub — Environment Variables
#
# Copy this file to .env (for local dev) and fill in your values.
# In production (Vercel), set these in the hosting dashboard.
#
# Variables prefixed with VITE_ are bundled into the client-side JS bundle.
# Only put PUBLIC / non-secret values here.
# ──────────────────────────────────────────────────────────────────────────────

# ── Firebase (client-side public config) ─────────────────────────────────────
# Get these from: Firebase Console → Project Settings → Your apps → Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=   # optional, for Google Analytics

# ── OpenRouter AI ─────────────────────────────────────────────────────────────
# Get a key at: https://openrouter.ai/keys
# Users can also enter their own key inside the app Settings page.
VITE_OPENROUTER_API_KEY=

# ── Super Admin ───────────────────────────────────────────────────────────────
# The email address that has super-admin access across all libraries.
VITE_SUPER_ADMIN_EMAIL=
