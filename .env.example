# ──────────────────────────────────────────────────────────────────────────────
# Amanah Keeper Hub — Environment Variables
#
# Copy this file to .env (for local dev) and fill in your values.
# In production (Vercel), set these in the hosting dashboard.
#
# Variables prefixed with VITE_ are bundled into the client-side JS bundle.
# Only put PUBLIC / non-secret values here.
# ──────────────────────────────────────────────────────────────────────────────

# ── Firebase (client-side public config) ─────────────────────────────────────
# Get these from: Firebase Console → Project Settings → Your apps → Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=   # optional, for Google Analytics

# ── OpenRouter AI ─────────────────────────────────────────────────────────────
# Get a key at: https://openrouter.ai/keys
# This key is stored SERVER-SIDE ONLY. Do NOT use the VITE_ prefix.
# It is never bundled into the client bundle or exposed to the browser.
OPENROUTER_API_KEY=

# AI model to use (defaults to openai/gpt-4o-mini if not set):
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: swap to any OpenAI-compatible AI provider endpoint:
# AI_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# Optional: cost per 1,000 tokens in USD for budget tracking (default: 0.00015):
# AI_COST_PER_1K_TOKENS=0.00015

# Optional: Firebase Admin SDK service account JSON (for server-side token verification).
# Generate at: Firebase Console → Project Settings → Service Accounts → Generate new private key.
# Paste the entire JSON as a single-line string.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Super-admin access is controlled by Firestore users/{uid}.role = "superadmin"
# Set the role manually in Firebase Console — never via env vars or source code.
