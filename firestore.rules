rules_version = '2';

// Amanah Library System — Firestore Security Rules
//
// Data model:
//   /users/{uid}                       (profile: uid, displayName, email, photoURL, role, createdAt, lastLoginAt)
//   /users/{uid}/borrows/{id}
//   /users/{uid}/reservations/{id}
//   /users/{uid}/notifications/{id}
//   /aiConversations/{id}              (userId, title, createdAt, updatedAt)
//   /aiConversations/{id}/messages/{id}(role, content, timestamp)
//   /auditLogs/{id}                    (userId, action, timestamp)
//   /support_messages/{id}             (contact/support inbox)
//
// Deploy with: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // The single super-admin email that controls the whole system.
    function superAdminEmail() {
      return 'usamaawol0@gmail.com';
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isSuperAdmin() {
      return isSignedIn()
             && request.auth.token.email != null
             && request.auth.token.email.lower() == superAdminEmail();
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // -------- User profiles --------
    // Each user manages their own profile; super-admin can read all and manage roles.
    match /users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow create, update: if isOwner(userId) || isSuperAdmin();
      allow delete: if isSuperAdmin();

      // Per-user workspace data (borrows, reservations, notifications).
      match /{collection}/{docId} {
        allow read, write: if isOwner(userId);
        allow read: if isSuperAdmin();
      }
    }

    // -------- AI conversations --------
    // Strictly isolated per user; super-admin may read all for monitoring.
    match /aiConversations/{convId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow read: if isSuperAdmin();

      match /messages/{msgId} {
        allow read, write: if isSignedIn()
          && get(/databases/$(database)/documents/aiConversations/$(convId)).data.userId == request.auth.uid;
        allow read: if isSuperAdmin();
      }
    }

    // -------- Audit logs --------
    // Users may append their own entries; only super-admin reads them.
    match /auditLogs/{id} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isSuperAdmin();
      allow update, delete: if false;
    }

    // -------- Support / contact messages --------
    match /support_messages/{id} {
      allow create: if isSignedIn()
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 5000;
      allow read, update, delete: if isSuperAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
